# Claude / Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI — used for embeddings only (text-embedding-3-small)
OPENAI_API_KEY=

# LinkedIn Developer App (linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# Tavily Search API (tavily.com)
TAVILY_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://linkedin_agent:password@localhost:5432/linkedin_agent
POSTGRES_USER=linkedin_agent
POSTGRES_PASSWORD=password
POSTGRES_DB=linkedin_agent

# ChromaDB — local vector store
CHROMA_PERSIST_DIR=./chroma_db

# App security
SECRET_KEY=change-this-to-a-random-secret-key

# Frontend
FRONTEND_URL=http://localhost:3000
